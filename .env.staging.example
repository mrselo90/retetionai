# Staging Environment Variables
# Copy this file to .env.staging and fill in your values

# Supabase (Staging Project)
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-key

# Redis (Staging Instance)
REDIS_URL=redis://your-staging-redis:6379

# API Configuration
PORT=3001
NODE_ENV=staging
LOG_LEVEL=info
ALLOWED_ORIGINS=https://staging.recete.co.uk

# Frontend Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
NEXT_PUBLIC_API_URL=https://api-staging.recete.co.uk

# OpenAI
OPENAI_API_KEY=your-openai-key

# Sentry (Optional)
SENTRY_DSN=https://your-staging-sentry-dsn
SENTRY_ENVIRONMENT=staging

# Shopify (Staging App)
SHOPIFY_API_KEY=your-staging-shopify-key
SHOPIFY_API_SECRET=your-staging-shopify-secret


# WhatsApp — each store links its own number by QR (packages/wa-worker/README.md)
# API + workers call the worker at WA_WORKER_URL; the worker calls back with the same secret.
WA_WORKER_URL=http://127.0.0.1:3005
WA_WORKER_SECRET=
# Worker only: connects as the restricted recete_wa_worker role, session tables in wa_session.
# Direct or session-mode pooler connection, not the transaction pooler (whatsmeow holds
# sessions open). The role's search_path is wa_session (migration 046).
WA_PG_DSN=postgres://recete_wa_worker:PASSWORD@HOST:5432/postgres?sslmode=require
WA_LISTEN_ADDR=127.0.0.1:3005
