{
  "name": "@recete/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b tsconfig.json --force",
    "typecheck": "tsc --noEmit",
    "start": "PORT=3001 node -r dotenv/config -r newrelic dist/index.js",
    "start:prod": "PORT=3002 node -r dotenv/config -r newrelic dist/index.js",
    "start:no-nr": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/swagger-ui": "^0.5.3",
    "@hono/zod-openapi": "^1.6.3",
    "@prometheus-io/client": "^0.16.1",
    "@recete/shared": "workspace:*",
    "@recete/workers": "workspace:*",
    "@sentry/node": "^10.76.2",
    "bullmq": "^5.81.5",
    "dotenv": "^16.6.1",
    "hono": "^4.13.13",
    "ioredis": "5.9.1",
    "newrelic": "^13.20.0",
    "openai": "^4.104.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
