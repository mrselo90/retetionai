// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["shopify"]
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@schema("shopify")
}

enum PlanType {
  STARTER
  GROWTH
  PRO

  @@schema("shopify")
}

enum BillingInterval {
  MONTHLY
  ANNUAL

  @@schema("shopify")
}

enum WebhookProcessingStatus {
  PENDING
  COMPLETED

  @@schema("shopify")
}

model Shop {
  id                String                  @id @default(cuid())
  shopDomain        String                  @unique
  planType          PlanType                @default(STARTER)
  billingInterval   BillingInterval         @default(MONTHLY)
  subscriptionId    String?
  subscriptionName  String?
  subscriptionLineItemId String?
  isTrial           Boolean                 @default(true)
  currentPeriodEnd  DateTime?
  themeEmbedEnabled Boolean                 @default(false)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  usageTracker      UsageTracker?
  products          Product[]
  webhookReceipts   WebhookReceipt[]
  usageEventReceipts UsageEventReceipt[]
  bulkDraftJobs     BulkDraftJob[]

  @@schema("shopify")
}

model UsageTracker {
  id                  String    @id @default(cuid())
  shopId              String    @unique
  shop                Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  chatsSentThisMonth  Int       @default(0)
  recipesCreatedCount Int       @default(0)
  photosAnalyzedCount Int       @default(0)
  periodStart         DateTime
  periodEnd           DateTime
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@schema("shopify")
}

model Product {
  id                String   @id @default(cuid())
  shopId            String
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  externalProductId String
  title             String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([shopId, externalProductId])
  @@schema("shopify")
}

model WebhookReceipt {
  id                 String                   @id @default(cuid())
  webhookId          String                   @unique
  shopId             String
  shop               Shop                     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  topic              String
  externalReference  String?
  status             WebhookProcessingStatus  @default(PENDING)
  chatIncrementApplied Boolean                @default(false)
  usageChargeApplied Boolean                  @default(false)
  processedAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@schema("shopify")
}

model UsageEventReceipt {
  id                 String    @id @default(cuid())
  shopId             String
  shop               Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  eventType          String
  externalEventId    String
  description        String?
  quantity           Int       @default(1)
  usageApplied       Boolean   @default(false)
  chargedUnits       Int       @default(0)
  usageRecordId      String?
  processedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([shopId, eventType, externalEventId])
  @@schema("shopify")
}

// "Draft all with AI" and "Update AI" run in the background
// (app/lib/bulkDraft.server.ts): the page polls this job instead of waiting on
// one long request. Only the latest job per shop is kept.
model BulkDraftJob {
  id           String          @id @default(cuid())
  kind         BulkJobKind     @default(DRAFT)
  shopId       String
  shop         Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopDomain   String
  status       BulkDraftStatus @default(RUNNING)
  limitReached Boolean         @default(false)
  finishedAt   DateTime?
  // When the merchant dismissed the result; until then it is shown again.
  seenAt       DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  items        BulkDraftItem[]

  @@index([shopId, createdAt])
  @@schema("shopify")
}

model BulkDraftItem {
  id               String              @id @default(cuid())
  jobId            String
  job              BulkDraftJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // Catalog order; items are worked through in this order.
  position         Int
  shopifyProductId String
  title            String
  handle           String
  descriptionHtml  String
  productType      String?
  vendor           String?
  // The Recete product, for "Update AI" items.
  recipeProductId  String?
  status           BulkDraftItemStatus @default(PENDING)
  error            String?
  updatedAt        DateTime            @updatedAt

  @@index([jobId, status])
  @@schema("shopify")
}

enum BulkJobKind {
  DRAFT
  PREPARE

  @@schema("shopify")
}

enum BulkDraftStatus {
  RUNNING
  DONE

  @@schema("shopify")
}

enum BulkDraftItemStatus {
  PENDING
  RUNNING
  SAVED
  FAILED
  SKIPPED

  @@schema("shopify")
}
