{
  "name": "@recete/shopify-app",
  "private": true,
  "scripts": {
    "prebuild": "prisma generate",
    "build": "react-router build",
    "dev": "pnpm exec shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma db push",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "prisma generate && react-router typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@react-router/dev": "^7.18.4",
    "@react-router/fs-routes": "^7.18.4",
    "@react-router/node": "^7.18.4",
    "@react-router/serve": "^7.18.4",
    "@shopify/app-bridge-react": "^4.2.14",
    "@shopify/shopify-app-react-router": "^4.0.0",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.1",
    "isbot": "^5.1.31",
    "prisma": "^6.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "^7.18.4",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^3.0.0",
    "@shopify/app-bridge-types": "0.7.3",
    "@shopify/polaris-types": "^2.0.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.18.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "graphql-config": "^5.1.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.6",
    "vitest": "^4.0.17"
  },
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0"
  },
  "author": "sboyuk"
}
