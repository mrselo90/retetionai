{
  "name": "recete-retention-agent",
  "version": "0.1.0",
  "private": true,
  "description": "White-label SaaS platform for post-purchase AI assistance via WhatsApp",
  "scripts": {
    "dev": "pnpm --filter api dev",
    "dev:shopify": "pnpm --filter @recete/shopify-app dev",
    "dev:web": "pnpm --filter @recete/web dev",
    "dev:all": "pnpm --parallel --filter api --filter @recete/web dev",
    "build": "pnpm --filter @recete/shared build && pnpm -r --filter '!@recete/shared' build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0 && pnpm lint:internal-auth-paths",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "lint:internal-auth-paths": "node scripts/check-internal-auth-paths.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "clean": "pnpm -r clean",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @recete/api test && pnpm --filter @recete/shared test",
    "test:integration": "pnpm --filter @recete/api test integration",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test packages/web/e2e/auth.spec.ts packages/web/e2e/dashboard.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:coverage": "pnpm --filter @recete/api test:coverage",
    "test:flow": "pnpm typecheck && pnpm test:unit && pnpm test:integration",
    "test:flow:full": "pnpm test:flow && pnpm test:e2e:smoke"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@shopify/cli": "^3.94.3",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19.0 <23",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
